---
import type { AnimKey } from '../utils/anim';

interface Props {
  name: AnimKey;
  static?: boolean;
  class?: string;
}
const { name, static: isStatic = false, class: className = '' } = Astro.props;

const labels: Record<AnimKey, string> = {
  'robot-roll': 'Робот-уборщик едет по объекту',
  'roi-chart': 'График окупаемости внедрения роботов',
  'route-map': 'Схема маршрута автономной уборки',
  'humans-robots': 'Гибридная модель: люди и роботы',
  'scan-pulse': 'Сканирование и дезинфекция помещения',
  'robot-mop': 'Робот моет пол щёткой',
  'robot-vacuum': 'Робот-пылесос убирает поверхность',
  'warehouse-bot': 'Робот убирает склад между стеллажами',
  'office-scene': 'Робот убирает офисное пространство',
  'data-dashboard': 'Панель управления данными уборки',
  'battery-charge': 'Робот на зарядной станции',
  'floor-sparkle': 'Чистый блестящий пол после уборки',
  'lidar-scan': 'Лидар-сканирование пространства',
  'cloud-connect': 'Облачное управление роботом',
  'gear-service': 'Техническое обслуживание робота',
  'cost-scale': 'Сравнение стоимости: ручной труд и робот',
  'partnership': 'Партнёрство и сотрудничество',
  'building-zones': 'План здания с зонами уборки',
  'robot-squad': 'Парк уборочных роботов',
  'timeline': 'Хронология и этапы внедрения',
};
---

<div
  class={`anim anim--${name}${isStatic ? ' is-static' : ''} ${className}`}
  role="img"
  aria-label={labels[name]}
>

  {/* 1. robot-roll */}
  {name === 'robot-roll' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <rect class="bg-box" x="70" y="120" width="70" height="120" rx="4" />
      <rect class="bg-box" x="150" y="150" width="54" height="90" rx="4" />
      <rect class="bg-box" x="720" y="110" width="80" height="130" rx="4" />
      <line x1="0" y1="290" x2="880" y2="290" class="floor" />
      <g class="rr-robot">
        <ellipse cx="60" cy="286" rx="70" ry="9" class="shadow" />
        <g class="bub b1"><circle cx="120" cy="150" r="6" /></g>
        <g class="bub b2"><circle cx="140" cy="120" r="4" /></g>
        <rect x="18" y="150" width="96" height="86" rx="18" class="body" />
        <rect x="34" y="120" width="64" height="26" rx="10" class="head" />
        <rect x="44" y="128" width="44" height="10" rx="5" class="visor" />
        <circle cx="66" cy="196" r="15" class="eye" />
        <circle cx="66" cy="196" r="6" class="pupil" />
        <path d="M116 210 l30 -6 M116 224 l30 0" class="speed" />
      </g>
    </svg>
  )}

  {/* 2. roi-chart */}
  {name === 'roi-chart' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <path d="M120 60 V300 H800" class="axis" />
      <g class="bars">
        <rect class="rc-bar" style="--d:0s;transform-origin:0 300px" x="180" y="230" width="70" height="70" rx="6" />
        <rect class="rc-bar" style="--d:.15s;transform-origin:0 300px" x="300" y="180" width="70" height="120" rx="6" />
        <rect class="rc-bar" style="--d:.3s;transform-origin:0 300px" x="420" y="130" width="70" height="170" rx="6" />
        <rect class="rc-bar rc-bar--hi" style="--d:.45s;transform-origin:0 300px" x="540" y="80" width="70" height="220" rx="6" />
      </g>
      <path class="rc-trend" d="M210 250 L335 205 L455 150 L580 100" />
      <path class="rc-arrow" d="M560 100 h24 v24" />
    </svg>
  )}

  {/* 3. route-map */}
  {name === 'route-map' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <rect x="120" y="40" width="640" height="280" rx="14" class="room" />
      <rect x="300" y="120" width="90" height="60" rx="6" class="obstacle" />
      <rect x="520" y="200" width="70" height="70" rx="6" class="obstacle" />
      <path class="rm-path" d="M170 90 H710 M710 90 V150 M710 150 H170 M170 150 V210 M170 210 H710 M710 210 V270 M710 270 H170" />
      <circle r="12" class="rm-dot" />
    </svg>
  )}

  {/* 4. humans-robots */}
  {name === 'humans-robots' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <g class="hr-fig hr-human">
        <circle cx="300" cy="140" r="34" class="fill-soft" />
        <path d="M250 300 v-40 a50 50 0 0 1 100 0 v40 z" class="fill-soft" />
      </g>
      <g class="hr-fig hr-robot">
        <rect x="520" y="120" width="120" height="90" rx="18" class="body" />
        <rect x="540" y="86" width="80" height="26" rx="10" class="head" />
        <rect x="552" y="94" width="56" height="10" rx="5" class="visor" />
        <circle cx="580" cy="164" r="16" class="eye" />
        <path d="M540 300 h80 l14 -90 h-108 z" class="base" />
      </g>
      <g class="hr-link">
        <path d="M368 200 h40 M472 200 h40" class="link-line" fill="none" />
        <circle cx="440" cy="200" r="20" class="link-node" />
        <path d="M432 200 h16 M440 192 v16" class="link-plus" fill="none" />
      </g>
    </svg>
  )}

  {/* 5. scan-pulse */}
  {name === 'scan-pulse' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <circle class="sp-ring" style="--d:0s" cx="440" cy="200" r="60" />
      <circle class="sp-ring" style="--d:.9s" cx="440" cy="200" r="60" />
      <circle class="sp-ring" style="--d:1.8s" cx="440" cy="200" r="60" />
      <g class="sp-robot">
        <rect x="392" y="150" width="96" height="80" rx="16" class="body" />
        <rect x="408" y="122" width="64" height="24" rx="10" class="head" />
        <rect x="418" y="129" width="44" height="10" rx="5" class="visor" />
        <circle cx="440" cy="192" r="16" class="eye" />
      </g>
      <path class="spark s1" d="M300 120 l6 14 14 6 -14 6 -6 14 -6 -14 -14 -6 14 -6z" />
      <path class="spark s2" d="M600 240 l4 10 10 4 -10 4 -4 10 -4 -10 -10 -4 10 -4z" />
    </svg>
  )}

  {/* 6. robot-mop */}
  {name === 'robot-mop' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <line x1="0" y1="290" x2="880" y2="290" class="floor" />
      <g class="mp-robot">
        <ellipse cx="440" cy="286" rx="80" ry="8" class="shadow" />
        <rect x="392" y="155" width="96" height="80" rx="18" class="body" />
        <rect x="408" y="126" width="64" height="26" rx="10" class="head" />
        <rect x="418" y="133" width="44" height="10" rx="5" class="visor" />
        <circle cx="440" cy="196" r="14" class="eye" />
        <circle cx="440" cy="196" r="5" class="pupil" />
        <ellipse class="mp-brush" cx="440" cy="256" rx="65" ry="10" />
        <circle class="mp-drop" style="--d:0s" cx="395" cy="270" r="3" />
        <circle class="mp-drop" style="--d:.6s" cx="440" cy="274" r="2.5" />
        <circle class="mp-drop" style="--d:1.2s" cx="485" cy="268" r="2" />
      </g>
    </svg>
  )}

  {/* 7. robot-vacuum (top-down) */}
  {name === 'robot-vacuum' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <g class="vc-body">
        <circle cx="440" cy="180" r="70" class="fill-soft" />
        <circle cx="440" cy="180" r="70" fill="none" stroke="var(--navy)" stroke-width="3" />
        <circle cx="440" cy="180" r="28" fill="none" stroke="var(--accent)" stroke-width="2.5" class="vc-brush" />
        <circle cx="440" cy="155" r="8" class="eye" />
        <circle cx="440" cy="155" r="3" class="pupil" />
        <path d="M470 150 a40 40 0 0 1 0 60" fill="none" stroke="var(--lime)" stroke-width="2" class="vc-sensor" />
      </g>
      <circle class="vc-dust" style="--d:0s" cx="300" cy="120" r="4" />
      <circle class="vc-dust" style="--d:.5s" cx="560" cy="240" r="3" />
      <circle class="vc-dust" style="--d:1s" cx="350" cy="260" r="3.5" />
      <circle class="vc-dust" style="--d:1.5s" cx="580" cy="130" r="2.5" />
    </svg>
  )}

  {/* 8. warehouse-bot */}
  {name === 'warehouse-bot' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <line x1="0" y1="290" x2="880" y2="290" class="floor" />
      <rect x="100" y="60" width="100" height="230" rx="4" fill="none" stroke="var(--navy)" stroke-width="2.5" />
      <line x1="100" y1="130" x2="200" y2="130" stroke="var(--navy)" stroke-width="2" />
      <line x1="100" y1="200" x2="200" y2="200" stroke="var(--navy)" stroke-width="2" />
      <rect x="120" y="70" width="60" height="50" rx="3" class="bg-box" />
      <rect x="115" y="140" width="70" height="50" rx="3" class="bg-box" />
      <rect x="390" y="60" width="100" height="230" rx="4" fill="none" stroke="var(--navy)" stroke-width="2.5" />
      <line x1="390" y1="130" x2="490" y2="130" stroke="var(--navy)" stroke-width="2" />
      <line x1="390" y1="200" x2="490" y2="200" stroke="var(--navy)" stroke-width="2" />
      <rect x="405" y="70" width="70" height="50" rx="3" class="bg-box" />
      <rect x="400" y="140" width="80" height="50" rx="3" class="bg-box" />
      <rect x="680" y="60" width="100" height="230" rx="4" fill="none" stroke="var(--navy)" stroke-width="2.5" />
      <line x1="680" y1="130" x2="780" y2="130" stroke="var(--navy)" stroke-width="2" />
      <line x1="680" y1="200" x2="780" y2="200" stroke="var(--navy)" stroke-width="2" />
      <rect x="695" y="70" width="70" height="50" rx="3" class="bg-box" />
      <g class="wh-robot">
        <ellipse cx="60" cy="286" rx="40" ry="6" class="shadow" />
        <rect x="30" y="230" width="60" height="48" rx="12" class="body" />
        <rect x="38" y="216" width="44" height="16" rx="7" class="head" />
        <rect x="44" y="220" width="32" height="8" rx="4" class="visor" />
        <circle cx="60" cy="256" r="8" class="eye" />
      </g>
    </svg>
  )}

  {/* 9. office-scene */}
  {name === 'office-scene' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <line x1="0" y1="290" x2="880" y2="290" class="floor" />
      <rect x="100" y="180" width="180" height="80" rx="4" fill="none" stroke="var(--navy)" stroke-width="2.5" />
      <rect x="160" y="140" width="60" height="40" rx="3" class="bg-box" />
      <rect x="170" y="148" width="40" height="24" rx="2" fill="var(--accent)" opacity="0.3" />
      <rect x="580" y="180" width="200" height="80" rx="4" fill="none" stroke="var(--navy)" stroke-width="2.5" />
      <rect x="650" y="140" width="60" height="40" rx="3" class="bg-box" />
      <rect x="660" y="148" width="40" height="24" rx="2" fill="var(--accent)" opacity="0.3" />
      <circle cx="200" cy="290" r="16" fill="none" stroke="var(--line-strong)" stroke-width="2" />
      <circle cx="680" cy="290" r="16" fill="none" stroke="var(--line-strong)" stroke-width="2" />
      <g class="of-robot">
        <ellipse cx="60" cy="286" rx="40" ry="6" class="shadow" />
        <rect x="30" y="216" width="60" height="56" rx="14" class="body" />
        <rect x="38" y="192" width="44" height="20" rx="8" class="head" />
        <rect x="44" y="198" width="32" height="8" rx="4" class="visor" />
        <circle cx="60" cy="246" r="10" class="eye" />
        <circle cx="60" cy="246" r="4" class="pupil" />
      </g>
    </svg>
  )}

  {/* 10. data-dashboard */}
  {name === 'data-dashboard' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <rect x="100" y="30" width="680" height="300" rx="16" fill="none" stroke="var(--navy)" stroke-width="3" />
      <line x1="100" y1="80" x2="780" y2="80" stroke="var(--line)" stroke-width="2" />
      <circle cx="130" cy="55" r="8" fill="var(--accent)" opacity="0.5" />
      <circle cx="155" cy="55" r="8" fill="var(--lime)" opacity="0.5" />
      <circle cx="180" cy="55" r="8" fill="var(--accent-soft)" />
      <rect class="dd-bar" style="--d:0s" x="160" y="220" width="50" height="80" rx="4" />
      <rect class="dd-bar" style="--d:.15s" x="240" y="170" width="50" height="130" rx="4" />
      <rect class="dd-bar dd-bar--hi" style="--d:.3s" x="320" y="130" width="50" height="170" rx="4" />
      <rect class="dd-bar" style="--d:.45s" x="400" y="180" width="50" height="120" rx="4" />
      <path class="dd-line" d="M540 260 L590 220 L640 240 L690 160 L740 180" />
      <circle class="dd-dot" cx="740" cy="180" r="6" />
    </svg>
  )}

  {/* 11. battery-charge */}
  {name === 'battery-charge' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <line x1="0" y1="290" x2="880" y2="290" class="floor" />
      <rect x="160" y="200" width="140" height="90" rx="10" fill="none" stroke="var(--navy)" stroke-width="3" />
      <rect x="180" y="220" width="30" height="50" rx="4" fill="var(--accent-soft)" stroke="var(--navy)" stroke-width="2" />
      <rect x="240" y="230" width="40" height="8" rx="2" fill="var(--accent)" opacity="0.5" />
      <g>
        <ellipse cx="460" cy="286" rx="70" ry="8" class="shadow" />
        <rect x="412" y="178" width="96" height="80" rx="18" class="body" />
        <rect x="428" y="150" width="64" height="24" rx="10" class="head" />
        <rect x="438" y="157" width="44" height="10" rx="5" class="visor" />
        <circle cx="460" cy="220" r="14" class="eye" />
        <circle cx="460" cy="220" r="5" class="pupil" />
      </g>
      <line x1="300" y1="245" x2="412" y2="220" stroke="var(--accent)" stroke-width="2.5" stroke-dasharray="6 4" class="bc-cable" />
      <rect x="620" y="120" width="80" height="130" rx="8" fill="none" stroke="var(--navy)" stroke-width="3" />
      <rect x="642" y="108" width="36" height="14" rx="4" fill="var(--navy)" />
      <rect class="bc-fill" x="628" y="190" width="64" height="52" rx="4" />
      <path class="bc-bolt" d="M656 145 l-8 22 h14 l-8 22" fill="none" stroke="var(--lime)" stroke-width="3" stroke-linecap="round" />
    </svg>
  )}

  {/* 12. floor-sparkle */}
  {name === 'floor-sparkle' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.25">
        <line x1="100" y1="120" x2="780" y2="120" stroke="var(--navy)" stroke-width="1.5" />
        <line x1="100" y1="190" x2="780" y2="190" stroke="var(--navy)" stroke-width="1.5" />
        <line x1="100" y1="260" x2="780" y2="260" stroke="var(--navy)" stroke-width="1.5" />
        <line x1="236" y1="50" x2="236" y2="330" stroke="var(--navy)" stroke-width="1.5" />
        <line x1="440" y1="50" x2="440" y2="330" stroke="var(--navy)" stroke-width="1.5" />
        <line x1="644" y1="50" x2="644" y2="330" stroke="var(--navy)" stroke-width="1.5" />
      </g>
      <path class="fs-star" style="--d:0s" d="M200 90 l5 12 12 5 -12 5 -5 12 -5 -12 -12 -5 12 -5z" />
      <path class="fs-star" style="--d:.5s" d="M500 155 l5 12 12 5 -12 5 -5 12 -5 -12 -12 -5 12 -5z" />
      <path class="fs-star" style="--d:1s" d="M340 230 l4 10 10 4 -10 4 -4 10 -4 -10 -10 -4 10 -4z" />
      <path class="fs-star" style="--d:1.5s" d="M680 100 l5 12 12 5 -12 5 -5 12 -5 -12 -12 -5 12 -5z" />
      <path class="fs-star" style="--d:2s" d="M580 280 l4 10 10 4 -10 4 -4 10 -4 -10 -10 -4 10 -4z" />
      <path class="fs-star" style="--d:2.5s" d="M160 280 l5 12 12 5 -12 5 -5 12 -5 -12 -12 -5 12 -5z" />
      <path class="fs-star" style="--d:3s" d="M720 210 l4 10 10 4 -10 4 -4 10 -4 -10 -10 -4 10 -4z" />
    </svg>
  )}

  {/* 13. lidar-scan */}
  {name === 'lidar-scan' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <g class="ls-beam">
        <path d="M440 178 L340 78 A140 140 0 0 1 540 78 Z" fill="var(--accent)" opacity="0.12" />
        <line x1="440" y1="178" x2="440" y2="38" stroke="var(--accent)" stroke-width="2" opacity="0.4" />
      </g>
      <rect x="404" y="148" width="72" height="60" rx="14" class="body" />
      <rect x="414" y="130" width="52" height="18" rx="8" class="head" />
      <rect x="422" y="135" width="36" height="8" rx="4" class="visor" />
      <circle cx="440" cy="178" r="10" class="eye" />
      <circle class="ls-dot" style="--d:0s" cx="300" cy="280" r="5" />
      <circle class="ls-dot" style="--d:.8s" cx="600" cy="100" r="5" />
      <circle class="ls-dot" style="--d:1.6s" cx="200" cy="150" r="5" />
      <circle class="ls-dot" style="--d:2.4s" cx="680" cy="260" r="5" />
    </svg>
  )}

  {/* 14. cloud-connect */}
  {name === 'cloud-connect' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <path class="cc-cloud" d="M350 120 Q320 120 320 92 Q320 60 365 54 Q378 25 440 25 Q502 25 515 54 Q560 60 560 92 Q560 120 530 120 Z" />
      <line x1="440" y1="120" x2="440" y2="250" stroke="var(--navy)" stroke-width="2" stroke-dasharray="6 5" opacity="0.35" />
      <rect x="400" y="250" width="80" height="60" rx="14" class="body" />
      <rect x="412" y="234" width="56" height="16" rx="7" class="head" />
      <rect x="420" y="239" width="40" height="7" rx="3" class="visor" />
      <circle cx="440" cy="280" r="10" class="eye" />
      <circle class="cc-pkt" style="--d:0s" cx="430" cy="250" r="5" />
      <circle class="cc-pkt" style="--d:1s" cx="450" cy="250" r="5" />
      <circle class="cc-pkt" style="--d:2s" cx="440" cy="250" r="4" />
    </svg>
  )}

  {/* 15. gear-service */}
  {name === 'gear-service' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <g class="gs-g1">
        <circle cx="340" cy="190" r="70" fill="#e6f6f8" stroke="var(--navy)" stroke-width="3" />
        <circle cx="340" cy="190" r="70" fill="none" stroke="var(--navy)" stroke-width="14" stroke-dasharray="18 16" />
        <circle cx="340" cy="190" r="18" fill="var(--accent-soft)" stroke="var(--navy)" stroke-width="2.5" />
      </g>
      <g class="gs-g2">
        <circle cx="510" cy="120" r="46" fill="#e6f6f8" stroke="var(--navy)" stroke-width="3" />
        <circle cx="510" cy="120" r="46" fill="none" stroke="var(--navy)" stroke-width="12" stroke-dasharray="14 12" />
        <circle cx="510" cy="120" r="12" fill="var(--accent-soft)" stroke="var(--navy)" stroke-width="2.5" />
      </g>
      <path class="gs-wrench" d="M560 220 l70 70 M618 278 l16 16 M622 274 l16 16" fill="none" stroke="var(--lime)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}

  {/* 16. cost-scale */}
  {name === 'cost-scale' && (
    <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg">
      <polygon points="440,220 420,290 460,290" fill="var(--navy)" />
      <g class="cs-beam">
        <line x1="200" y1="220" x2="680" y2="220" stroke="var(--navy)" stroke-width="4" stroke-linecap="round" />
        <line x1="200" y1="220" x2="160" y2="270" stroke="var(--navy)" stroke-width="2" />
        <line x1="200" y1="220" x2="240" y2="270" stroke="var(--navy)" stroke-width="2" />
        <path d="M150 270 a50 15 0 0 0 100 0" fill="var(--accent-soft)" stroke="var(--navy)" stroke-width="2" />
        <circle cx="200" cy="240" r="10" class="fill-soft" />
        <path d="M188 268 v-6 a12 12 0 0 1 24 0 v6" class="fill-soft" />
        <line x1="680" y1="220" x2="640" y2="270" stroke="var(--navy)" stroke-width="2" />
        <line x1="680" y1="220" x2="720" y2="270" stroke="var(--navy)" stroke-width="2" />
        <path d="M630 270 a50 15 0 0 0 100 0" fill="var(--accent-soft)" stroke="var(--navy)" stroke-width="2" />
