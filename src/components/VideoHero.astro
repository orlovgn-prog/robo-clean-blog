---
// Видео-заставка (герой). Автоплей без звука, зациклено, постер для LCP.
// При prefers-reduced-motion видео не проигрывается — показывается постер.
---

<section class="vhero">
  <video
    class="vhero-media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/media/hero-poster.jpg"
    aria-hidden="true"
  >
    <source src="/media/hero.mp4" type="video/mp4" />
  </video>
  <div class="vhero-scrim" aria-hidden="true"></div>

  <div class="container vhero-inner">
    <span class="eyebrow vhero-eyebrow">Робототехника для клининга</span>
    <h1 class="vhero-title">
      Роботы, которые убирают<br />офисы, склады и <span class="hl">бизнес-центры</span>
    </h1>
    <p class="vhero-sub">
      Новости индустрии, кейсы внедрений, обзоры моделей и экономика автоматизации.
      Материалы готовит ИИ-редакция на основе реальных источников.
    </p>
    <div class="vhero-cta">
      <a href="/articles" class="btn btn-primary">Читать статьи</a>
      <a href="/about" class="btn vhero-ghost">О проекте</a>
    </div>
  </div>
</section>

<style>
  .vhero {
    position: relative;
    min-height: clamp(560px, 88vh, 940px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #05070a;
  }
  .vhero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .vhero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(3, 6, 10, 0.82) 0%, rgba(3, 6, 10, 0.45) 42%, rgba(3, 6, 10, 0) 70%),
      linear-gradient(0deg, rgba(3, 6, 10, 0.55) 0%, rgba(3, 6, 10, 0) 45%);
  }

  .vhero-inner { position: relative; z-index: 2; color: #fff; padding-block: 80px; }
  .vhero-eyebrow { color: var(--accent); }
  .vhero-title {
    color: #fff;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    margin: 16px 0 18px;
    max-width: 15ch;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.5);
  }
  .vhero-title .hl { color: var(--accent); }
  .vhero-sub {
    color: rgba(255, 255, 255, 0.86);
    font-size: 1.12rem;
    max-width: 540px;
    margin: 0 0 28px;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.5);
  }
  .vhero-cta { display: flex; gap: 12px; flex-wrap: wrap; }

  /* светлая «призрачная» кнопка на тёмном видео */
  .vhero-ghost {
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.7);
    color: #fff;
    backdrop-filter: blur(4px);
  }
  .vhero-ghost:hover { background: rgba(255, 255, 255, 0.18); border-color: #fff; color: #fff; }

  @media (max-width: 640px) {
    .vhero-sub { font-size: 1rem; }
  }
</style>

<script>
  const v = document.querySelector<HTMLVideoElement>('.vhero-media');
  if (v) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      // Уважаем «уменьшить движение»: видео не грузим вовсе — остаётся постер.
      v.removeAttribute('autoplay');
      v.preload = 'none';
      while (v.firstChild) v.removeChild(v.firstChild);
      v.load();
    } else if ('IntersectionObserver' in window) {
      // Пауза, когда заставка ушла из вида — экономим CPU/трафик.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) v.play().catch(() => {});
            else v.pause();
          }
        },
        { threshold: 0.1 }
      );
      io.observe(v);
    }
  }
</script>
