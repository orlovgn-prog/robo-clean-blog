---
// Яндекс.Метрика. Впишите ID счётчика в METRIKA_ID.
// Если ID пустой — скрипт не рендерится, сайт работает без аналитики.
const METRIKA_ID = '111355510'; // ← ваш ID счётчика Яндекс.Метрики

const tagSrc = `https://mc.yandex.ru/metrika/tag.js?id=${METRIKA_ID}`;
---

{METRIKA_ID && (
  <Fragment>
    <script
      is:inline
      type="text/javascript"
      set:html={`
    (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
    })(window, document,'script','${tagSrc}', 'ym');

    ym(${METRIKA_ID}, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
  `}
    />
    <noscript>
      <div>
        <img
          src={`https://mc.yandex.ru/watch/${METRIKA_ID}`}
          style="position:absolute; left:-9999px;"
          alt=""
        />
      </div>
    </noscript>
  </Fragment>
)}
