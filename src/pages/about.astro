---
import BaseLayout from '../layouts/BaseLayout.astro';
import RobotArt from '../components/RobotArt.astro';
import Subscribe from '../components/Subscribe.astro';
import { RUBRICS } from '../utils/taxonomy';

const principles = [
  {
    title: 'Реальные источники',
    text: 'Новости собираются из открытых отраслевых источников по всему миру и переводятся на русский — с обязательной ссылкой на первоисточник.',
  },
  {
    title: 'Рерайт, а не копипаст',
    text: 'Тексты пересказываются и суммируются оригинально. Мы не копируем чужие материалы целиком и уважаем условия использования и robots.txt источников.',
  },
  {
    title: 'Только по теме',
    text: 'Каждый материал проходит фильтр релевантности: публикуем только про робо-клининг и автоматизацию уборки коммерческих объектов.',
  },
  {
    title: 'Прозрачность',
    text: 'Автособранные новости помечены как подготовленные ИИ-редакцией, у каждой указан источник и дата оригинала.',
  },
];
---

<BaseLayout title="О проекте" description="RoboClean — независимое медиа об автоматизации клининга коммерческих объектов: новости, кейсы, обзоры, экономика.">
  <!-- Интро -->
  <section class="section">
    <div class="container about-hero">
      <div class="about-text">
        <span class="eyebrow">О проекте</span>
        <h1>Медиа об автоматизации клининга</h1>
        <p class="lead">
          <strong>RoboClean</strong> — независимое издание о робототехнике для уборки
          коммерческих объектов: бизнес-центров, складов, торговых центров, логистических
          хабов, аэропортов и вокзалов.
        </p>
        <p class="muted">
          Мы разбираем модели роботов и производителей, считаем экономику внедрения,
          собираем кейсы и следим за рынком. Аудитория — управляющие недвижимостью,
          владельцы клининговых компаний, фасилити-менеджеры, закупщики и инвесторы.
        </p>
      </div>
      <div class="about-art">
        <RobotArt class="robot" />
      </div>
    </div>
  </section>

  <!-- Рубрики -->
  <section class="section pt-0">
    <div class="container">
      <div class="sec-head"><h2>Что внутри</h2></div>
      <div class="rub-grid">
        {RUBRICS.map((r) => (
          <a href={`/rubric/${r.slug}/`} class="rub-card">
            <span class="rub-ico" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={r.icon}></svg>
            </span>
            <span class="rub-name">{r.name}</span>
            <span class="rub-desc muted">{r.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Как делаем контент -->
  <section class="section pt-0">
    <div class="container">
      <div class="sec-head"><h2>Как мы делаем контент</h2></div>
      <p class="about-note muted">
        Часть материалов пишет редакция, часть — <strong>ИИ-редакция</strong>: новости
        индустрии собираются автоматически 2–3 раза в неделю, переводятся, пересказываются
        и публикуются с указанием источника. Вот принципы, которым мы следуем.
      </p>
      <div class="prin-grid">
        {principles.map((p) => (
          <div class="prin-card">
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Подписка -->
  <section class="section pt-0">
    <div class="container">
      <Subscribe />
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 48px;
    align-items: center;
  }
  .about-text h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: 12px 0 18px; }
  .lead { font-size: 1.2rem; color: var(--text); margin: 0 0 16px; }
  .lead strong { color: var(--navy); }
  .about-text .muted { font-size: 1.05rem; }
  .about-art {
    display: grid; place-items: center;
    background: #f2fbfc;
    border: var(--edge);
    border-radius: var(--radius);
    box-shadow: var(--pop);
    padding: 28px;
  }
  .about-art .robot { width: min(260px, 90%); }

  .sec-head { margin-bottom: 22px; }
  .sec-head h2 { font-size: 1.5rem; margin: 0; }
  .pt-0 { padding-top: 0; }

  .rub-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .rub-card {
    display: flex; flex-direction: column; gap: 8px;
    padding: 20px; border-radius: var(--radius);
    background: #fff; border: var(--edge); box-shadow: var(--pop-sm);
    color: var(--text); transition: transform 0.14s ease, box-shadow 0.14s ease;
  }
  .rub-card:hover { transform: translate(-3px, -3px); box-shadow: 8px 8px 0 0 #e6f8fa, 8px 8px 0 2px #0e3a44; }
  .rub-ico {
    display: grid; place-items: center; width: 44px; height: 44px;
    border-radius: 12px; background: var(--surface-2); border: 1.5px solid var(--navy); color: var(--navy);
  }
  .rub-ico svg { width: 24px; height: 24px; }
  .rub-name { font-weight: 800; color: var(--navy); }
  .rub-desc { font-size: 0.85rem; line-height: 1.4; }

  .about-note { max-width: 760px; font-size: 1.05rem; margin: 0 0 24px; }
  .prin-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .prin-card {
    padding: 24px; border-radius: var(--radius);
    background: #fff; border: var(--edge);
  }
  .prin-card h3 { font-size: 1.1rem; margin: 0 0 8px; }
  .prin-card p { margin: 0; font-size: 0.96rem; line-height: 1.55; }

  @media (max-width: 900px) {
    .about-hero { grid-template-columns: 1fr; }
    .about-art { order: -1; }
    .rub-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .rub-grid, .prin-grid { grid-template-columns: 1fr; }
  }
</style>
